# Godot
.godot/
*.translation
export.cfg
export_presets.cfg
Build/

# Godot's editor scans src/ too (even though those .cs files are excluded
# from compilation) and generates stray .uid sidecars for them - src/ isn't
# Godot scripts, so these aren't meaningful.
src/**/*.cs.uid

# .NET
bin/
obj/
.vs/
*.user

# Raw/extracted ZDoom Wiki material (GNU FDL 1.2) used as research
# input for hover doc comments - never ship or commit the wiki's own
# text itself. See wiki-research/README.md (tracked, along with
# merged_docs.json and generate_docs_data.py - those hold only this
# project's own original wording, not wiki content).
wiki-research/raw/
wiki-research/manifest/
wiki-research/extracted.json
wiki-research/batches/
wiki-research/batch-out/
