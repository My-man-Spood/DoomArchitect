[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/View/ResourceListEditor.cs" id="1"]

[node name="ResourceListEditor" type="VBoxContainer"]
script = ExtResource("1")

[node name="HintLabel" type="Label" parent="."]
layout_mode = 2
autowrap_mode = 2
text = "Additional resources"

[node name="ItemList" type="ItemList" parent="."]
layout_mode = 2
custom_minimum_size = Vector2(300, 100)

[node name="ButtonsRow" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="AddButton" type="Button" parent="ButtonsRow"]
layout_mode = 2
text = "Add..."

[node name="RemoveButton" type="Button" parent="ButtonsRow"]
layout_mode = 2
text = "Remove selected"

[node name="AddFileDialog" type="FileDialog" parent="."]
title = "Add Resource WAD"
initial_position = 1
size = Vector2i(640, 480)
exclusive = false
file_mode = 0
access = 2
filters = PackedStringArray("*.wad ; Doom WAD files")

[node name="ErrorDialog" type="AcceptDialog" parent="."]
title = "Error"
initial_position = 1
exclusive = false
